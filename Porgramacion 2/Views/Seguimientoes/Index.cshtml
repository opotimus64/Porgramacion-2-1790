@model IEnumerable<Porgramacion_2.Models.Seguimiento>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Comentario)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Fecha)
        </th>
        <th>
            Estado
        </th>
        <th>
            Estado Anterior / Nuevo
        </th>
        <th>
            Responsable
        </th>
        <th>
            Solicitud
        </th>
        <th></th>
    </tr>
@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Comentario)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Fecha)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Estado.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Estado1.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Responsable.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Solicitud.Descripcion)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.IdSeguimiento }) |
            @Html.ActionLink("Details", "Details", new { id=item.IdSeguimiento }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.IdSeguimiento })
        </td>
    </tr>
}

</table>
